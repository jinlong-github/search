BRAVE_SEARCH_API_KEY=replace_me
# Optional: enables patent proxy
PATENTSVIEW_API_KEY=replace_me_if_available

# Research OS v22: optional multi-provider profiles.
# When AI_PROFILES_JSON is configured, /api/ai/summaries routes through these server-side profiles.
# Browser/project requests only send the profile id; URLs and keys remain server-side.
# AI_DEFAULT_PROFILE=openai
# AI_ALLOW_PROFILE_OVERRIDE=true
# AI_PROFILES_JSON=[{"id":"openai","name":"OpenAI","provider":"OpenAI","baseUrl":"https://api.openai.com/v1","mode":"responses","path":"/responses","model":"gpt-5-mini","keyBinding":"AI_KEY_OPENAI","authHeader":"Authorization","authPrefix":"Bearer ","allowedModels":["gpt-5-mini"],"allowModelOverride":true,"allowPromptOverride":true,"defaultPrompt":""},{"id":"private","name":"Private Model","provider":"Internal","baseUrl":"https://ai.example.com/v1","mode":"chat-completions","path":"/chat/completions","model":"research-model","keyBinding":"AI_KEY_PRIVATE","authHeader":"x-api-key","authPrefix":"","allowedModels":["research-model"],"allowModelOverride":true,"allowPromptOverride":true,"defaultPrompt":""}]
# Secrets are separate bindings and must not be written into AI_PROFILES_JSON:
# AI_KEY_OPENAI=replace_me
# AI_KEY_PRIVATE=replace_me

# v21 / single-provider fallback (server-side only).
# These variables continue to work when AI_PROFILES_JSON is empty.
# Preferred generic secret name. OPENAI_API_KEY remains supported as a fallback.
AI_API_KEY=replace_me
# OPENAI_API_KEY=replace_me

# Upstream provider and protocol.
AI_PROVIDER_NAME=OpenAI
AI_BASE_URL=https://api.openai.com/v1
# responses | chat-completions
AI_API_MODE=responses
# Examples: /responses or /chat/completions
AI_API_PATH=/responses
AI_MODEL=gpt-5-mini

# Authentication header. For standard Bearer auth keep the defaults below.
AI_AUTH_HEADER=Authorization
AI_AUTH_PREFIX=Bearer 

# Optional runtime overrides from the Research OS UI.
# If false, the Worker always uses AI_MODEL.
AI_ALLOW_MODEL_OVERRIDE=true
# Optional comma-separated allowlist. Empty means any model name is accepted when override is enabled.
AI_ALLOWED_MODELS=
AI_ALLOW_PROMPT_OVERRIDE=true

# Optional server-side default prompt. Browser/project prompts are appended after the fixed evidence rules.
AI_DEFAULT_PROMPT=

# Optional cost estimation in the control center.
# Set these to your provider/model USD price per 1M tokens. Do not hard-code stale prices in frontend code.
AI_INPUT_USD_PER_1M=
AI_OUTPUT_USD_PER_1M=
# Backward-compatible names are also supported:
# OPENAI_INPUT_USD_PER_1M=
# OPENAI_OUTPUT_USD_PER_1M=

ALLOWED_ORIGINS=https://jinlong-github.github.io,http://localhost:8000
