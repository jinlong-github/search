# Search providers
BRAVE_SEARCH_API_KEY=replace_me
PATENTSVIEW_API_KEY=replace_me_if_available
ALLOWED_ORIGINS=https://jinlong-github.github.io,http://localhost:8000

# Recommended AI configuration: Provider Profiles
AI_DEFAULT_PROFILE=openai
AI_ALLOW_PROFILE_OVERRIDE=true
AI_PROFILES_JSON=[{"id":"openai","name":"OpenAI Research","provider":"OpenAI","baseUrl":"https://api.openai.com/v1","mode":"responses","path":"/responses","model":"gpt-5-mini","keyBinding":"AI_KEY_OPENAI","authHeader":"Authorization","authPrefix":"Bearer ","allowedModels":["gpt-5-mini"],"allowModelOverride":true,"allowPromptOverride":true}]

# Local development only. Production uses: npx wrangler secret put AI_KEY_OPENAI
AI_KEY_OPENAI=replace_me

# Legacy single-provider fallback remains supported when AI_PROFILES_JSON is empty:
# AI_API_KEY=replace_me
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_MODE=responses
# AI_API_PATH=/responses
# AI_MODEL=gpt-5-mini
# AI_ALLOWED_MODELS=
# OPENAI_INPUT_USD_PER_1M=   # legacy cost alias
# OPENAI_OUTPUT_USD_PER_1M=  # legacy cost alias
